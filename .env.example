# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Security & Authentication
JWT_SECRET="opticraft_super_secret_jwt_key_2026"
ADMIN_PIN="998877"

# Razorpay / Payment Gateway Config (Indian Market Integration)
RAZORPAY_KEY_ID="rzp_test_opticraft12345"
RAZORPAY_KEY_SECRET="test_secret_opticraft_secure_67890"
RAZORPAY_WEBHOOK_SECRET="whsec_opticraft_webhook_secret_2026"

# Database Configuration (PostgreSQL / Durable File Storage)
# For Railway: Use the Public Networking TCP Proxy URL (e.g., "postgresql://postgres:password@junction.proxy.rlwy.net:12345/railway")
# Note: "postgres.railway.internal" only resolves inside Railway's private network, not external environments.
DATABASE_URL="postgres://opticraft_user:password@localhost:5432/opticraft_db"
DB_FILE_PATH="./data/opticraft_db.json"

# Authkey.io WhatsApp API Integration
# 1. AUTHKEY_API_KEY: Your Authkey.io API Key (from Authkey.io Dashboard -> Profile / API Keys)
# 2. AUTHKEY_WHATSAPP_WID: Your approved WhatsApp Template ID (wid) for OTP authentication
# The backend automatically generates a 6-digit number OTP (valid for 2 minutes) and passes it to Authkey.
AUTHKEY_API_KEY=""
AUTHKEY_WHATSAPP_WID=""
AUTHKEY_VARIABLE_NAME="otp"

# Shiprocket API Logistics Integration (Indian Pincode Serviceability & Live Order Tracking)
# 1. SHIPROCKET_EMAIL: Your registered Shiprocket business email
# 2. SHIPROCKET_PASSWORD: Your Shiprocket account password
# 3. SHIPROCKET_PICKUP_PINCODE: Warehouse origin PIN code (e.g. 560038 for Bengaluru Indiranagar Hub)
# 4. SHIPROCKET_API_TOKEN: Optional direct Bearer token (if generated directly from Shiprocket Dashboard)
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""
SHIPROCKET_PICKUP_PINCODE="560038"
SHIPROCKET_API_TOKEN=""
